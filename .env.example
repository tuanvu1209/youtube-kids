# Postgres (Neon qua Vercel Marketplace, Supabase, hoặc bất kỳ Postgres nào)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Chuỗi bí mật để ký cookie phiên đăng nhập — đổi giá trị khác khi deploy
AUTH_SECRET="kidtube-dev-secret-change-me"

# Điền YouTube Data API v3 key để bật tính năng tìm kiếm video trong app.
# Bỏ trống vẫn dùng được: phụ huynh dán link YouTube để thêm video (qua oEmbed).
YOUTUBE_API_KEY=""

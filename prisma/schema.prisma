generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Parent {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  pin          String   @default("1234")
  createdAt    DateTime @default(now())

  kids      Kid[]
  playlists Playlist[]
  likes     PlaylistLike[]
  reports   Report[]
}

model Kid {
  id            String   @id @default(cuid())
  parentId      String
  name          String
  avatar        String   @default("🐻")
  ageGroup      String   @default("3-5")
  dailyLimitMin Int      @default(30)
  createdAt     DateTime @default(now())

  parent      Parent        @relation(fields: [parentId], references: [id], onDelete: Cascade)
  assignments KidPlaylist[]
  watches     WatchEvent[]

  @@index([parentId])
}

model Playlist {
  id          String   @id @default(cuid())
  ownerId     String
  title       String
  description String   @default("")
  emoji       String   @default("🎨")
  ageGroup    String   @default("3-5")
  isPublic    Boolean  @default(false)
  copiedFrom  String?
  copyCount   Int      @default(0)
  createdAt   DateTime @default(now())

  owner       Parent         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  items       PlaylistItem[]
  assignments KidPlaylist[]
  likes       PlaylistLike[]

  @@index([ownerId])
  @@index([isPublic, ageGroup])
}

model Video {
  id           String   @id @default(cuid())
  youtubeId    String   @unique
  title        String
  channelTitle String   @default("")
  thumbnailUrl String   @default("")
  durationSec  Int      @default(0)
  createdAt    DateTime @default(now())

  items   PlaylistItem[]
  watches WatchEvent[]
  reports Report[]
}

model PlaylistItem {
  id         String   @id @default(cuid())
  playlistId String
  videoId    String
  position   Int      @default(0)
  createdAt  DateTime @default(now())

  playlist Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  video    Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@unique([playlistId, videoId])
  @@index([playlistId])
}

model KidPlaylist {
  id         String   @id @default(cuid())
  kidId      String
  playlistId String
  createdAt  DateTime @default(now())

  kid      Kid      @relation(fields: [kidId], references: [id], onDelete: Cascade)
  playlist Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)

  @@unique([kidId, playlistId])
  @@index([kidId])
}

model PlaylistLike {
  id         String   @id @default(cuid())
  parentId   String
  playlistId String
  createdAt  DateTime @default(now())

  parent   Parent   @relation(fields: [parentId], references: [id], onDelete: Cascade)
  playlist Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)

  @@unique([parentId, playlistId])
  @@index([playlistId])
}

model Report {
  id        String   @id @default(cuid())
  parentId  String
  videoId   String
  reason    String   @default("")
  createdAt DateTime @default(now())

  parent Parent @relation(fields: [parentId], references: [id], onDelete: Cascade)
  video  Video  @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@index([videoId])
}

model WatchEvent {
  id        String   @id @default(cuid())
  kidId     String
  videoId   String
  seconds   Int      @default(0)
  createdAt DateTime @default(now())

  kid   Kid   @relation(fields: [kidId], references: [id], onDelete: Cascade)
  video Video @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@index([kidId, createdAt])
}
